# All switches: 2.0x on 2 x B300 (QwenOFT / Qwen3-VL-4B / LIBERO, per-GPU batch 16). Not bitwise: the two
# STARVLA_COMPILE_* switches change floating-point rounding; validated statistically and by LIBERO evaluation.
# Usage: source scripts/configs/faster.env before launching the training script. Unset to get the upstream code path.
# What each switch does: starVLA/training/trainer_utils/fastpath.py
export STARVLA_PREP_IN_WORKERS=1
export STARVLA_SKIP_LM_HEAD=1
export STARVLA_FAST_ATTN_MASK=1
export STARVLA_BATCHED_VISION_ATTN=1
export STARVLA_VISION_POS_CACHE=1
export STARVLA_DS_FUSED_GRAD_NORM=1
export STARVLA_COMPILE_LM=1
export STARVLA_DS_PLAIN_ALLREDUCE=1
export STARVLA_COMPILE_VISION=1
