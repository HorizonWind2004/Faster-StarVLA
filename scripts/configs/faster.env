# Every fast path: 2.0x on 2 x B300 (QwenOFT / Qwen3-VL-4B / LIBERO, per-GPU batch 16). Not bitwise: the compiled
# layers change floating-point rounding; validated statistically and by LIBERO evaluation.
# Usage: source scripts/configs/faster.env before launching a training script (the same as: export STARVLA_FAST=all).
# Unset STARVLA_FAST to get the upstream code path. What each fast path does: starVLA/fast/__init__.py
export STARVLA_FAST=all
