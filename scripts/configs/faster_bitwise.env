# Bit-exact fast paths only: training is bitwise identical to upstream (loss, gradients, updates, Adam states).
# Usage: source scripts/configs/faster_bitwise.env before launching a training script (the same as: export
# STARVLA_FAST=exact). Unset STARVLA_FAST to get the upstream code path. What each fast path does: starVLA/fast/__init__.py
export STARVLA_FAST=exact
